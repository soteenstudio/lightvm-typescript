{
  "name": "lightvm-ts",
  "description": "This template is created to make it easier for developers when first starting to use LightVM",
  "type": "module",
  "scripts": {
    "test": "node ./dist/index.js",
    "dev": "node ./build.dev.js",
    "build": "node ./build.js",
    "typecheck": "npx tsc",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "lightvm": "0.1.0-alpha.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
